APP_NAME="Clearford Global"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ────────────────────────────────────────────────
# Default: SQLite (suitable for development and low-traffic production)
# For MySQL/PostgreSQL, uncomment the block below.
DB_CONNECTION=mysql
DB_HOST=db.fr-roub1.bengt.wasmernet.com
DB_PORT=20184
DB_DATABASE=clearfordglobaldb
DB_USERNAME=user_cd113d9a
DB_PASSWORD=pw_SEi2neKyV1tUDi2kapSptQSCDIWOT2AA

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# ── Mail (Hostinger SMTP) ────────────────────────────────────
# Configure these with your Hostinger SMTP credentials.
# MAIL_MAILER=smtp
# MAIL_SCHEME=ssl
# MAIL_HOST=smtp.hostinger.com
# MAIL_PORT=465
# MAIL_USERNAME=your-email@yourdomain.com
# MAIL_PASSWORD=your-email-password
# MAIL_FROM_ADDRESS=your-email@yourdomain.com
# MAIL_FROM_NAME="${APP_NAME}"

# Development: log emails to storage/logs/laravel.log
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@clearfordglobal.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Inquiry Destination ──────────────────────────────────────
# The email address that receives project inquiry notifications.
INQUIRY_TO_ADDRESS=inquiries@clearfordglobal.com

# ── Auto-reply ───────────────────────────────────────────────
# Set to false to disable auto-reply emails to form submitters.
MAIL_SEND_AUTO_REPLY=true

# ── Google reCAPTCHA v3 ──────────────────────────────────────
# Get keys at: https://www.google.com/recaptcha/admin/create
# Leave empty to disable reCAPTCHA (not recommended for production).
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ── Company Contact Email ────────────────────────────────────
COMPANY_CONTACT_EMAIL=hello@clearfordglobal.com

# ── AWS (not required unless using S3 file storage) ─────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
